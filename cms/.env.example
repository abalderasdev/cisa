# Secreto obligatorio. Genera uno: openssl rand -hex 32
PAYLOAD_SECRET=

# Postgres compartido por red Docker interna (hostname típico: supabase-db).
# SSL suele ir disabled en red interna. Schema vía PAYLOAD_SCHEMA / adapter.
DATABASE_URL=postgresql://cisa_app:CAMBIAR@supabase-db:5432/postgres

# Controla serverURL, csrf y cors. Local: http://localhost:3000
# Producción: https://cms.cisa.abdev.io
PAYLOAD_PUBLIC_SERVER_URL=https://cms.cisa.abdev.io
SERVER_URL=https://cms.cisa.abdev.io

# Schema Postgres. En el VPS ABDev el schema `cisa` YA existe: no vuelvas a crear
# schema ni un Postgres nuevo ni abras el puerto 5432. SQL de referencia en docs/cms.md.
PAYLOAD_SCHEMA=cisa

PORT=3000

# Red Docker externa del servicio Supabase en Coolify (la define VPS ABDev).
COMPOSE_NETWORK=

# Uploads de Media: directorio media/ en local; en contenedor /app/media (volumen).
