# Secreto obligatorio de Payload. Genera uno con: openssl rand -hex 32
PAYLOAD_SECRET=

# Conexión al PostgreSQL compartido por la red Docker interna.
# Sustituye CAMBIAR y, si aplica, ajusta usuario y contraseña.
# El schema se configura mediante schemaName/PAYLOAD_SCHEMA.
# SSL puede stay disabled dentro de la red interna, según la configuración de Supabase.
DATABASE_URL=postgresql://cisa_app:CAMBIAR@supabase-db:5432/postgres

# URL pública del CMS.
PAYLOAD_PUBLIC_SERVER_URL=https://cms.cisa.abdev.io
SERVER_URL=https://cms.cisa.abdev.io

# Schema de PostgreSQL utilizado por Payload.
PAYLOAD_SCHEMA=cisa

# Puerto local del contenedor.
PORT=3000

# Red Docker externa compartida con Supabase en Coolify/VPS ABDev.
COMPOSE_NETWORK=
