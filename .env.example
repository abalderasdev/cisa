# ============================================
# CISA site · Vercel Environment Variables
# ============================================
#
# Agente público CISA (/api/agente-cisa). Las claves son SECRETAS:
# configúralas solo en Vercel como "Sensitive"; solo las usa el servidor.
# ============================================
MINIMAX_API_KEY=
XAI_API_KEY=
# Opcionales (tienen valor por defecto en api/agente-cisa.js):
MINIMAX_TEXT_MODEL=
MINIMAX_TTS_MODEL=
MINIMAX_TTS_VOICE=
XAI_VOICE_MODEL=
XAI_VOICE=
# Orígenes extra permitidos, separados por coma (p. ej. https://www.gcisa.mx)
AGENTE_CISA_ORIGINS=

# ============================================
# Editor en vivo (ver EDITOR.md). ESTAS SÍ SON SECRETAS:
# configúralas solo en Vercel como "Sensitive", nunca aquí con valor.
# ============================================
EDITOR_SESSION_SECRET=
# usuario:scrypt$... (npm run hash-password -- <usuario>), separados por coma
EDITOR_USERS=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
